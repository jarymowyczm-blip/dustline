{
  "name": "dustline-fps",
  "private": true,
  "version": "1.0.0",
  "description": "DUSTLINE — a realistic browser FPS built with Three.js. Procedural geometry, PBR textures, IBL lighting, GTAO, procedural audio. No external assets.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "vite --open",
    "build:single": "vite build && node tools/bundle-single.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "fps",
    "three.js",
    "webgl",
    "game",
    "webgl2",
    "shooter"
  ],
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
